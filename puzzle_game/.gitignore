# Puzzle Game specific gitignore

# Save files (keep the example but ignore user saves)
savegame.json
!savegame.json.example

# Test files
test_*.py
*_test.py

# Temporary files
*.tmp
*.log
*.bak

# User-specific saves
user_save_*.json
auto_save_*.json

# Pygame cache
__pycache__/
*.pyc
*.pyo

# IDE files
.vscode/
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db
